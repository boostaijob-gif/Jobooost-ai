{
  "entities": {
    "Feedback": {
      "title": "User Feedback",
      "description": "User suggestions and issue reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["suggestion", "issue", "other"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "type", "createdAt"]
    },
    "JobAlert": {
      "title": "Job Alert Subscription",
      "description": "User subscription for real-time job alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "seniority": { "type": "string" },
        "environment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "location", "createdAt"]
    },
    "Notification": {
      "title": "Job Notification",
      "description": "Notification for a job match",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "jobData": { "type": "object" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "jobData", "isRead", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "onboardingCompleted"]
    },
    "Job": {
      "title": "Job Posting",
      "description": "Scraped and ingested job postings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "seniority": { "type": "string" },
        "industry": { "type": "string" },
        "jobType": { "type": "string" },
        "datePosted": { "type": "string" },
        "sourceSite": { "type": "string" },
        "salaryRange": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "currency": { "type": "string" }
          }
        },
        "technologies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "company", "description", "location", "url", "createdAt"]
    },
    "SavedJob": {
      "title": "Saved Job",
      "description": "Job liked or saved by the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobData": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "jobId", "jobData", "createdAt"]
    }
  },
  "firestore": {
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Collection of user feedback"
    },
    "/jobAlerts/{alertId}": {
      "schema": "JobAlert",
      "description": "Collection of job alert subscriptions"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of scraped and ingested job postings"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of job match notifications"
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of extended user profiles"
    },
    "/savedJobs/{savedJobId}": {
      "schema": "SavedJob",
      "description": "Collection of jobs saved by users"
    }
  }
}
